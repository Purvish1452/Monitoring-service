{
  "info": {
    "_postman_id": "8f2d5a36-1e9c-4e89-b0d7-2f3493c12345",
    "name": "High-Throughput Network Monitoring Service API",
    "description": "Comprehensive Postman collection for testing the Java 21 + Eclipse Vert.x 5.0.0 High-Throughput Network Monitoring Service.\n\nIncludes endpoints for Healthy, Degraded, HTTP 500, HTTP 404, TCP Connection Refused, and Timeout states.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health & System Metrics",
      "item": [
        {
          "name": "Health Check (< 50ms) [AC 2]",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Ultra-fast health check answered directly from in-memory state in < 2ms without EventBus or DB roundtrips (Satisfies AC 2)."
          },
          "response": []
        },
        {
          "name": "System & Heap Metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/metrics",
              "host": ["{{baseUrl}}"],
              "path": ["api", "metrics"]
            },
            "description": "Returns current JVM heap memory usage, total memory, max memory (-Xmx1g), and available processor cores."
          },
          "response": []
        },
        {
          "name": "Web UI Dashboard HTML",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            },
            "description": "Returns the decoupled real-time dark-mode monitoring dashboard HTML served via StaticHandler."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Target Management (Single)",
      "item": [
        {
          "name": "Register HTTP Target (Healthy - Google)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"target-http-google\",\n  \"type\": \"HTTP\",\n  \"url\": \"https://www.google.com\",\n  \"intervalSeconds\": 1,\n  \"timeoutMs\": 2000,\n  \"expectedStatusCode\": 200,\n  \"retryPolicy\": {\n    \"maxAttempts\": 3,\n    \"baseDelayMs\": 200,\n    \"backoffFactor\": 2.0\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/targets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "targets"]
            },
            "description": "Registers a healthy HTTP target with a custom ID."
          },
          "response": []
        },
        {
          "name": "Register HTTP Target (Without ID - Auto UUID)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"HTTP\",\n  \"url\": \"https://cloudflare.com\",\n  \"intervalSeconds\": 1,\n  \"timeoutMs\": 2000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/targets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "targets"]
            },
            "description": "Registers a target WITHOUT supplying an 'id'. The service auto-generates 'target-<UUID>'."
          },
          "response": []
        },
        {
          "name": "Register TCP Target (Healthy - Cloudflare DNS)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"target-tcp-dns-cf\",\n  \"type\": \"TCP\",\n  \"ip\": \"1.1.1.1\",\n  \"port\": 53,\n  \"intervalSeconds\": 1,\n  \"timeoutMs\": 2000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/targets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "targets"]
            },
            "description": "Registers a raw TCP socket target probing port 53 (DNS)."
          },
          "response": []
        },
        {
          "name": "List All Targets",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/targets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "targets"]
            },
            "description": "Returns all registered targets."
          },
          "response": []
        },
        {
          "name": "Get Target By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/targets/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "targets", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "target-http-google"
                }
              ]
            },
            "description": "Retrieves configuration for a specific target by ID."
          },
          "response": []
        },
        {
          "name": "Delete Target",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/targets/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "targets", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "target-http-google"
                }
              ]
            },
            "description": "Deletes target and cancels all future scheduled checks."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Testing Different Target Statuses (Failing, Degraded, Timeout)",
      "item": [
        {
          "name": "Register Failing Target (HTTP 500 Internal Server Error)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"target-failing-500\",\n  \"type\": \"HTTP\",\n  \"url\": \"https://httpbin.org/status/500\",\n  \"intervalSeconds\": 1,\n  \"timeoutMs\": 2000,\n  \"expectedStatusCode\": 200,\n  \"retryPolicy\": {\n    \"maxAttempts\": 3,\n    \"baseDelayMs\": 100,\n    \"backoffFactor\": 2.0\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/targets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "targets"]
            },
            "description": "Probes an endpoint that always returns HTTP 500 Error, triggering failure and retries."
          },
          "response": []
        },
        {
          "name": "Register Failing Target (HTTP 404 Not Found)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"target-failing-404\",\n  \"type\": \"HTTP\",\n  \"url\": \"https://httpbin.org/status/404\",\n  \"intervalSeconds\": 1,\n  \"timeoutMs\": 2000,\n  \"expectedStatusCode\": 200,\n  \"retryPolicy\": {\n    \"maxAttempts\": 3,\n    \"baseDelayMs\": 100,\n    \"backoffFactor\": 2.0\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/targets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "targets"]
            },
            "description": "Probes an endpoint that always returns HTTP 404 Not Found."
          },
          "response": []
        },
        {
          "name": "Register Failing Target (TCP Connection Refused - Closed Port)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"target-tcp-closed-port\",\n  \"type\": \"TCP\",\n  \"ip\": \"127.0.0.1\",\n  \"port\": 59998,\n  \"intervalSeconds\": 1,\n  \"timeoutMs\": 1000,\n  \"retryPolicy\": {\n    \"maxAttempts\": 2,\n    \"baseDelayMs\": 50,\n    \"backoffFactor\": 2.0\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/targets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "targets"]
            },
            "description": "Probes a closed local TCP port, triggering Connection Refused errors."
          },
          "response": []
        },
        {
          "name": "Register Degraded Target (Slow 2s Latency)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"target-slow-degraded-2s\",\n  \"type\": \"HTTP\",\n  \"url\": \"https://httpbin.org/delay/2\",\n  \"intervalSeconds\": 3,\n  \"timeoutMs\": 4000,\n  \"expectedStatusCode\": 200\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/targets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "targets"]
            },
            "description": "Probes an endpoint with artificial 2.0-second response latency (Slow / Degraded)."
          },
          "response": []
        },
        {
          "name": "Register Timeout Target (Non-Routable Blackhole)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"target-timeout-blackhole\",\n  \"type\": \"HTTP\",\n  \"url\": \"http://10.255.255.1/blackhole\",\n  \"intervalSeconds\": 2,\n  \"timeoutMs\": 1000,\n  \"retryPolicy\": {\n    \"maxAttempts\": 2,\n    \"baseDelayMs\": 50,\n    \"backoffFactor\": 2.0\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/targets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "targets"]
            },
            "description": "Probes a non-routable IP address to verify strict timeout enforcement (AC 3)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Bulk Operations (High-Throughput)",
      "item": [
        {
          "name": "Register Bulk Targets (Mixed Statuses - Healthy, 500, 404, Slow, TCP)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"id\": \"target-google-ok\",\n    \"type\": \"HTTP\",\n    \"url\": \"https://www.google.com\",\n    \"intervalSeconds\": 1,\n    \"timeoutMs\": 2000\n  },\n  {\n    \"id\": \"target-error-500\",\n    \"type\": \"HTTP\",\n    \"url\": \"https://httpbin.org/status/500\",\n    \"intervalSeconds\": 1,\n    \"timeoutMs\": 2000\n  },\n  {\n    \"id\": \"target-error-404\",\n    \"type\": \"HTTP\",\n    \"url\": \"https://httpbin.org/status/404\",\n    \"intervalSeconds\": 1,\n    \"timeoutMs\": 2000\n  },\n  {\n    \"id\": \"target-slow-2s\",\n    \"type\": \"HTTP\",\n    \"url\": \"https://httpbin.org/delay/2\",\n    \"intervalSeconds\": 3,\n    \"timeoutMs\": 4000\n  },\n  {\n    \"id\": \"target-tcp-dns-ok\",\n    \"type\": \"TCP\",\n    \"ip\": \"8.8.8.8\",\n    \"port\": 53,\n    \"intervalSeconds\": 1,\n    \"timeoutMs\": 2000\n  },\n  {\n    \"id\": \"target-tcp-closed-fail\",\n    \"type\": \"TCP\",\n    \"ip\": \"127.0.0.1\",\n    \"port\": 59998,\n    \"intervalSeconds\": 1,\n    \"timeoutMs\": 1000\n  }\n]"
            },
            "url": {
              "raw": "{{baseUrl}}/api/targets/bulk",
              "host": ["{{baseUrl}}"],
              "path": ["api", "targets", "bulk"]
            },
            "description": "Registers a mix of healthy, failing (500/404), slow, and closed-port targets simultaneously."
          },
          "response": []
        },
        {
          "name": "Trigger Bulk Re-Check [AC 7]",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/targets/bulk-check",
              "host": ["{{baseUrl}}"],
              "path": ["api", "targets", "bulk-check"]
            },
            "description": "Triggers immediate parallel re-check across all registered targets (AC 7: returns HTTP 202 immediately)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "5. On-Demand Probes & Alerts",
      "item": [
        {
          "name": "Trigger Immediate Check (Check Now)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/targets/:id/check",
              "host": ["{{baseUrl}}"],
              "path": ["api", "targets", ":id", "check"],
              "variable": [
                {
                  "key": "id",
                  "value": "target-http-google"
                }
              ]
            },
            "description": "Forces an on-demand probe check for a target without waiting for its scheduled tick."
          },
          "response": []
        },
        {
          "name": "List Active Alerts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/alerts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "alerts"]
            },
            "description": "Returns historical and active health state transition alerts (UP/DEGRADED/DOWN)."
          },
          "response": []
        }
      ]
    }
  ]
}
